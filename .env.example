# Web development server proxies /api to this address.
VITE_API_URL=

# Web authentication (Clerk)
VITE_CLERK_PUBLISHABLE_KEY=

# API
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Persistence and background jobs
MONGODB_URI=mongodb://127.0.0.1:27017/vdyo
REDIS_URL=redis://127.0.0.1:6379

# AI Director
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Private S3-compatible object storage (Cloudflare R2 / AWS S3)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=vdyo-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Upload controls
MAX_UPLOAD_BYTES=5368709120
ALLOWED_UPLOAD_TYPES=video/mp4,video/quicktime,video/webm,image/jpeg,image/png,audio/mpeg,audio/mp4

# Worker
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_PRESET=veryfast
VIDEO_WORKER_CONCURRENCY=1
